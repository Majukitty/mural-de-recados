<h1>Mural de Recados</h1>
<%= link_to "Escreva um novo recado", new_message_path %>
<% if @messages.empty? %>
    <p>Ainda nao há recado. Que tal postar o primeiro?</p>
<% end %>

<% @messages.each do |message| %>
    <div>
        <p> recado: <%= message.content %></p>
        <p> autor: <%= message.author %></p>
        <%= link_to "Editar", edit_message_path(message) %>
        <%= button_to "Apagar", message, method: :delete, form: { data: { turbo_confirm: "Quer mesmo apagar este recado?" } } %>
    </div>
    <hr>
<% end %>